############################################################
# TAG ATTACHMENT DEMANDS
############################################################

### Get Tag Attachments Currently Under Review
# Get all tag attachments that are currently under review (status = "pending")
# Requires: Employee authentication
# Query Parameters:
#   - page: Page number (default: 1)
#   - limit: Items per page (default: 10)
#   - tagId: Filter by tag ID (optional)
#   - userId: Filter by user ID (optional)
#   - sortBy: Field to sort by (default: 'createdAt')
#   - sortOrder: 'asc' or 'desc' (default: 'desc')
GET {{baseUrl}}/demands/tag-attachments?page=1&limit=10
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Tag Attachments Under Review - Filter by Tag
GET {{baseUrl}}/demands/tag-attachments?page=1&limit=10&tagId=uuid-here
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Tag Attachments Under Review - Filter by User
GET {{baseUrl}}/demands/tag-attachments?page=1&limit=10&userId=uuid-here
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Tag Attachments Under Review - Sorted by Created Date
GET {{baseUrl}}/demands/tag-attachments?page=1&limit=10&sortBy=createdAt&sortOrder=asc
Authorization: Bearer {{token}}
Content-Type: application/json

############################################################
# TAG ATTACHMENT COUNT ENDPOINT
############################################################

### Get Count of Tag Attachments Under Review
# Get the total count of tag attachments currently under review
# Requires: Employee authentication
# Query Parameters:
#   - tagId: Filter by tag ID (optional)
#   - userId: Filter by user ID (optional)
GET {{baseUrl}}/demands/tag-attachments/count
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Count of Tag Attachments Under Review - Filter by Tag
GET {{baseUrl}}/demands/tag-attachments/count?tagId=uuid-here
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Count of Tag Attachments Under Review - Filter by User
GET {{baseUrl}}/demands/tag-attachments/count?userId=uuid-here
Authorization: Bearer {{token}}
Content-Type: application/json

