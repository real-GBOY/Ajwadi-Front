### Demand Management API
### Base URL: http://localhost:5000/api

### Variables
@baseUrl = http://localhost:5000/api
@token = your_employee_jwt_token_here

############################################################
# VERIFICATION DEMANDS
############################################################

### Get Users Currently Under Review
# Get all users that are currently under review for verification
# Requires: Employee authentication
# Query Parameters:
#   - page: Page number (default: 1)
#   - limit: Items per page (default: 10)
#   - search: Search by name
#   - sortBy: Field to sort by (default: 'createdAt')
#   - sortOrder: 'asc' or 'desc' (default: 'desc')
#   - mode: Filter by mode ('freelancer' or 'client')
GET {{baseUrl}}/demands/verification?page=1&limit=10
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Users Under Review - With Search
GET {{baseUrl}}/demands/verification?page=1&limit=10&search=john
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Users Under Review - Filter by Mode
GET {{baseUrl}}/demands/verification?page=1&limit=10&mode=freelancer
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Users Under Review - Sorted by Name
GET {{baseUrl}}/demands/verification?page=1&limit=10&sortBy=name&sortOrder=asc
Authorization: Bearer {{token}}
Content-Type: application/json

############################################################
# COUNT ENDPOINT
############################################################

### Get Count of Users Under Review
# Get the total count of users currently under review
# Requires: Employee authentication
# Query Parameters:
#   - search: Search by name (optional)
#   - mode: Filter by mode ('freelancer' or 'client') (optional)
GET {{baseUrl}}/demands/verification/count
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Count of Users Under Review - With Search
GET {{baseUrl}}/demands/verification/count?search=john
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Count of Users Under Review - Filter by Mode
GET {{baseUrl}}/demands/verification/count?mode=freelancer
Authorization: Bearer {{token}}
Content-Type: application/json

### Get Count of Users Under Review - With Search and Mode
GET {{baseUrl}}/demands/verification/count?search=john&mode=freelancer
Authorization: Bearer {{token}}
Content-Type: application/json

############################################################
# Response Format
############################################################

# Success Response (200 OK):
# {
#   "success": true,
#   "message": "Users under review fetched successfully",
#   "data": [
#     {
#       "id": "uuid",
#       "name": "User Name",
#       "phone": "+1234567890",
#       "mode": "freelancer",
#       "isCurrentlyUnderReview": true,
#       "isVerifiedAsFreelancer": false,
#       "isVerifiedAsClient": false,
#       "profilePictureFile": {
#         "id": "uuid",
#         "url": "https://...",
#         "fileName": "profile.jpg",
#         ...
#       },
#       "createdAt": "2026-02-14T00:00:00.000Z",
#       ...
#     }
#   ],
#   "pagination": {
#     "currentPage": 1,
#     "itemsPerPage": 10,
#     "totalItems": 25,
#     "totalPages": 3,
#     "hasNextPage": true,
#     "hasPreviousPage": false
#   }
# }

# Error Response (401 Unauthorized):
# {
#   "success": false,
#   "message": "Unauthorized"
# }

# Error Response (403 Forbidden):
# {
#   "success": false,
#   "message": "Forbidden - Employee access required"
# }

############################################################
# Count Response Format
############################################################

# Success Response (200 OK):
