Content-Type: {{contentType}}
Authorization: Bearer {{employeeToken}}

### Response Example:
### {
###   "success": true,
###   "message": "All transactions fetched successfully",
###   "data": [
###     {
###       "id": "transaction-uuid",
###       "userId": "user-uuid",
###       "amount": 100.5,
###       "currency": "SAR",
###       "type": "TOP_UP",
###       "status": "COMPLETED",
###       "createdAt": "2024-01-01T00:00:00.000Z",
###       "updatedAt": "2024-01-01T00:05:00.000Z"
###     }
###   ]
### }

