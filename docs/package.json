{
  "name": "ajwadi-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"nodemon ./src/server.js\" \"node ./src/Workers/s3upload.worker.mjs\"",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "db:create": "npx sequelize-cli db:create",
    "db:drop": "npx sequelize-cli db:drop",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "migrate:status": "npx sequelize-cli db:migrate:status",
    "verify:migrations": "node scripts/verify-models-migrations.js",
    "worker:s3": "node ./src/Workers/s3upload.worker.js",
    "chat:sync": "node scripts/sync-chat-users.js",
    "chat:sync:dry": "node scripts/sync-chat-users.js --dry-run",
    "ensure:app-wallet": "node scripts/ensure-app-wallet.js",
    "seed": "node scripts/seed-all-data.js"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "@aws-sdk/client-sns": "^3.972.0",
    "@aws-sdk/client-sqs": "^3.972.0",
    "@aws-sdk/node-http-handler": "^3.374.0",
    "@aws-sdk/s3-request-presigner": "^3.971.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.1",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.1",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "socket.io": "^4.8.3",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.0.5",
    "mongodb": "^7.1.0",
    "nodemon": "^3.1.11",
    "sequelize-auto-migrations": "^1.0.3",
    "supertest": "^7.1.3"
  }
}
