# Absolute URL of the backend API. Required in production (Vercel) —
# without it the app falls back to a relative "/api" path, which does not
# exist on Vercel since this project deploys the frontend only.
VITE_API_BASE_URL=https://your-backend-domain.com/api

# Optional: WebSocket base URL for socket.io. If omitted, it is derived
# from VITE_API_BASE_URL (strips a trailing /api).
VITE_WS_URL=https://your-backend-domain.com
